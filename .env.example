# Local preflight only; no scheduler, report reader or sender is implemented yet.
APP_MODE=preview
ENABLE_OUTBOUND=false

# Reserved for later agreed seams. These values are not used to contact Lark now.
BUSINESS_TIMEZONE=Africa/Nairobi
SQLITE_FILE_PATH=./data/task-list.sqlite
LARK_APP_ID=
LARK_APP_SECRET=
# An operational user OAuth credential flow must be agreed before source reads.
# Never copy your broad interactive CLI session into this file for production.
LARK_USER_ACCESS_TOKEN=
LARK_USER_REFRESH_TOKEN=

SOURCE_CHAT_ID=
ALLOWED_SOURCE_CHAT_IDS=
MANAGEMENT_CHAT_ID=
TEST_CHAT_ID=
# Future live smoke sends must be separately authorized; populate only approved test IDs.
ALLOWED_DESTINATION_CHAT_IDS=
# Calendar, activation date and production retention policy remain unconfigured.
HOLIDAY_CALENDAR_PATH=
ACTIVATION_DATE=
