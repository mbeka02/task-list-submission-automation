# Safe default: preview. Production sending needs explicit activation and live access checks.
APP_MODE=preview
ENABLE_OUTBOUND=false
# JSON operational events go to stderr; command-result JSON remains on stdout.
# info logs changes and a ten-minute heartbeat; debug includes every due check.
LOG_LEVEL=info

# Status uses app/group scope and local state only; run may read Lark at/after 10:01.
BUSINESS_TIMEZONE=Africa/Nairobi
SQLITE_FILE_PATH=./data/task-list.sqlite
LARK_APP_ID=
LARK_APP_SECRET=
# Selected reader: the approved user account and app.
# Provision a separate worker OAuth grant; never copy the CLI refresh token.
# Required by worker run; provision separately before an authorized live read.
LARK_READER_OPEN_ID=
LARK_USER_CREDENTIAL_FILE=./data/credentials/user-oauth.json
# Only used by worker-auth start/finish. Confirm enabled user scopes in the app console.
LARK_OAUTH_SCOPES=im:message:readonly contact:user.base:readonly

SOURCE_CHAT_ID=
ALLOWED_SOURCE_CHAT_IDS=
# Private operator/admin reports group. Keep its real ID outside Git.
REPORT_RECIPIENT_TYPE=chat_id
REPORT_RECIPIENT_ID=
# Select signed custom bots for the external reports and source groups in production.
# app_bot remains the default for supported development groups.
REPORT_TRANSPORT=app_bot
REMINDER_TRANSPORT=app_bot
REPORT_WEBHOOK_URL=
REPORT_WEBHOOK_SIGNING_SECRET=
REMINDER_WEBHOOK_URL=
REMINDER_WEBHOOK_SIGNING_SECRET=
TEST_CHAT_ID=
# Future live smoke sends must be separately authorized; populate only approved test IDs.
ALLOWED_DESTINATION_CHAT_IDS=
# Supply a reviewed, versioned Kenyan calendar covering activation through today.
# No real annual holiday dataset is bundled; production retention remains unconfigured.
HOLIDAY_CALENDAR_PATH=./data/kenyan-holidays.json
ACTIVATION_DATE=
POLICY_VERSION=task-list-v3
# Delay after each completed due check; default 60 seconds, no overlapping checks.
WORKER_CHECK_INTERVAL_MS=60000
# Keep true during manual recovery. The storage restore command also creates a
# persistent review marker that this flag cannot bypass.
WORKER_RESTORE_MODE=false

# Optional 10:15 capture; production publish mode needs explicit outbound activation.
# No model key is needed to capture or inspect status.
ENABLE_DAILY_BRIEF=false
BRIEF_MODE=capture_only
BRIEF_ACTIVATION_DATE=
BRIEF_TEMPLATE_VERSION=template-v1
BRIEF_PROMPT_VERSION=prompt-v1
BRIEF_SCHEMA_VERSION=schema-v1
# Provider/model are frozen metadata in capture-only mode; future publishing must match them.
# Employee task-text processing needs owner approval. Never commit a populated key.
BRIEF_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Required only for activated brief publication; keep tokens private.
# Production external-group briefs use user_oauth: operator owns/edits, group views.
# Fresh login must also request docs:doc docx:document
# docs:permission.member:retrieve
# docs:permission.member:create docs:permission.setting:read
# docs:permission.setting:write_only. Existing grants cannot gain scopes by refresh.
LARK_DOC_AUTH_STRATEGY=app
LARK_DOC_STAGING_FOLDER_TOKEN=
LARK_DOCUMENT_BASE_URL=
