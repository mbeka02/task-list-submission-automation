# Local preflight only; SDK reader is a library, with no scheduled/live command yet.
APP_MODE=preview
ENABLE_OUTBOUND=false

# Reserved for later agreed seams. These values are not used to contact Lark now.
BUSINESS_TIMEZONE=Africa/Nairobi
SQLITE_FILE_PATH=./data/task-list.sqlite
LARK_APP_ID=
LARK_APP_SECRET=
# Selected initial reader: current approved app and Anthony's account.
# Provision a separate worker OAuth grant; never copy the CLI refresh token.
# These reserved fields are not wired into a live command yet.
LARK_READER_OPEN_ID=
LARK_USER_CREDENTIAL_FILE=./data/user-oauth.json

SOURCE_CHAT_ID=
ALLOWED_SOURCE_CHAT_IDS=
MANAGEMENT_CHAT_ID=
TEST_CHAT_ID=
# Future live smoke sends must be separately authorized; populate only approved test IDs.
ALLOWED_DESTINATION_CHAT_IDS=
# Calendar, activation date and production retention policy remain unconfigured.
HOLIDAY_CALENDAR_PATH=
ACTIVATION_DATE=
