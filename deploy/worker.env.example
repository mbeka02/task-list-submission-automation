# Static preview settings only. Place the real file at /opt/task-list/worker.env.
# Unquoted/raw values; Doppler supplies LARK_APP_SECRET separately.
LARK_APP_ID=cli_replace_with_approved_app
SOURCE_CHAT_ID=oc_replace_with_source_group
REPORT_RECIPIENT_TYPE=chat_id
REPORT_RECIPIENT_ID=oc_replace_with_development_test_group
LARK_READER_OPEN_ID=ou_replace_with_approved_reader
ACTIVATION_DATE=2099-01-01
LOG_LEVEL=info
WORKER_CHECK_INTERVAL_MS=60000

# Select webhook for both external groups only after destination/access acceptance.
REPORT_TRANSPORT=app_bot
REMINDER_TRANSPORT=app_bot
WORKER_RESTORE_MODE=true
