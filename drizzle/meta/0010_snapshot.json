      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "brief_valid_revision": {
          "name": "brief_valid_revision",
          "value": "\"daily_brief\".\"revision\" >= 1"
        },
        "brief_publication_state": {
          "name": "brief_publication_state",
          "value": "\"daily_brief\".\"publicationState\" IN ('pending','creating','writing','verifying','sharing','verified','published','review_required')"
        },
        "brief_document_hash": {
          "name": "brief_document_hash",
          "value": "\"daily_brief\".\"documentHash\" IS NULL OR (length(\"daily_brief\".\"documentHash\") = 64 AND \"daily_brief\".\"documentHash\" NOT GLOB '*[^0-9a-f]*')"
        },
        "brief_document_revision": {
          "name": "brief_document_revision",
          "value": "\"daily_brief\".\"documentRevision\" IS NULL OR \"daily_brief\".\"documentRevision\" >= 0"
        },
        "brief_write_token_json": {
          "name": "brief_write_token_json",
          "value": "json_valid(\"daily_brief\".\"documentWriteTokens\") AND json_type(\"daily_brief\".\"documentWriteTokens\") = 'array'"
        },
        "brief_publication_claim": {
          "name": "brief_publication_claim",
          "value": "(\"daily_brief\".\"publicationClaimToken\" IS NULL AND \"daily_brief\".\"publicationClaimExpiresMs\" IS NULL) OR (\"daily_brief\".\"publicationClaimToken\" IS NOT NULL AND \"daily_brief\".\"publicationClaimExpiresMs\" IS NOT NULL AND \"daily_brief\".\"publicationClaimExpiresMs\" >= 0)"
        },
        "brief_verified_reference": {
          "name": "brief_verified_reference",
          "value": "\"daily_brief\".\"publicationState\" NOT IN ('verified','published') OR (\"daily_brief\".\"documentUrl\" IS NOT NULL AND \"daily_brief\".\"documentHash\" IS NOT NULL AND \"daily_brief\".\"documentRevision\" IS NOT NULL)"
        },
        "brief_valid_capture": {
          "name": "brief_valid_capture",
          "value": "\"daily_brief\".\"captureThroughMs\" >= 0 AND \"daily_brief\".\"observedAtMs\" >= \"daily_brief\".\"captureThroughMs\""
        },
        "brief_valid_provider": {
          "name": "brief_valid_provider",
          "value": "\"daily_brief\".\"provider\" IN ('gemini', 'deepseek')"
        },
        "brief_doc_mode": {
          "name": "brief_doc_mode",
          "value": "\"daily_brief\".\"outputMode\" = 'doc'"
        },
        "brief_input_state": {
          "name": "brief_input_state",
          "value": "\"daily_brief\".\"state\" = 'input_frozen'"
        },
        "brief_generation_state": {
          "name": "brief_generation_state",
          "value": "\"daily_brief\".\"generationState\" IN ('pending', 'generating', 'content_ready', 'review_required')"
        },
        "brief_generation_attempt_cap": {
          "name": "brief_generation_attempt_cap",
          "value": "\"daily_brief\".\"generationAttemptCount\" BETWEEN 0 AND 2"
        },
        "brief_generation_kind": {
          "name": "brief_generation_kind",
          "value": "\"daily_brief\".\"generationKind\" IS NULL OR \"daily_brief\".\"generationKind\" IN ('ai', 'fallback', 'empty')"
        },
        "brief_generation_attempt_json": {
          "name": "brief_generation_attempt_json",
          "value": "json_valid(\"daily_brief\".\"generationAttempts\") AND json_type(\"daily_brief\".\"generationAttempts\") = 'array' AND json_array_length(\"daily_brief\".\"generationAttempts\") = \"daily_brief\".\"generationAttemptCount\""
        }
      }
    },
