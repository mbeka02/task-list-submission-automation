# Local preflight and preview worker; command-line sending remains disabled.
APP_MODE=preview
ENABLE_OUTBOUND=false
# JSON operational events go to stderr; command-result JSON remains on stdout.
# info logs changes and a ten-minute heartbeat; debug includes every due check.
LOG_LEVEL=info

# Status uses app/group scope and local state only; run may read Lark at/after 10:01.
BUSINESS_TIMEZONE=Africa/Nairobi
SQLITE_FILE_PATH=./data/task-list.sqlite
LARK_APP_ID=
LARK_APP_SECRET=
# Selected initial reader: current approved app and Anthony's account.
# Provision a separate worker OAuth grant; never copy the CLI refresh token.
# Required by worker run; provision separately before an authorized live read.
LARK_READER_OPEN_ID=
LARK_USER_CREDENTIAL_FILE=./data/credentials/user-oauth.json
# Only used by worker-auth start/finish. Confirm enabled user scopes in the app console.
LARK_OAUTH_SCOPES=im:message.group_msg:get_as_user contact:user.base:readonly

SOURCE_CHAT_ID=
ALLOWED_SOURCE_CHAT_IDS=
# Local placeholder until management access and the real destination are verified.
MANAGEMENT_CHAT_ID=oc_management_placeholder
TEST_CHAT_ID=
# Future live smoke sends must be separately authorized; populate only approved test IDs.
ALLOWED_DESTINATION_CHAT_IDS=
# Supply a reviewed, versioned Kenyan calendar covering activation through today.
# No real annual holiday dataset is bundled; production retention remains unconfigured.
HOLIDAY_CALENDAR_PATH=./data/kenyan-holidays.json
ACTIVATION_DATE=
POLICY_VERSION=task-list-v2
# Delay after each completed due check; default 60 seconds, no overlapping checks.
WORKER_CHECK_INTERVAL_MS=60000
# Keep true during manual recovery. The storage restore command also creates a
# persistent review marker that this flag cannot bypass.
WORKER_RESTORE_MODE=false

# Optional 10:15 capture. CLI publishing stays rejected; no model key is needed to capture.
ENABLE_DAILY_BRIEF=false
BRIEF_MODE=capture_only
BRIEF_ACTIVATION_DATE=
BRIEF_TEMPLATE_VERSION=template-v1
BRIEF_PROMPT_VERSION=prompt-v1
BRIEF_SCHEMA_VERSION=schema-v1
# Provider/model are frozen metadata in capture-only mode; future publishing must match them.
# Free-tier demos use synthetic data only. Never commit a populated key.
BRIEF_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
