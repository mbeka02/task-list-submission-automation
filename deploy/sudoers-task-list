# Validate with the host visudo before installing as root:root, mode 0440.
# sudo-rs rejects argument wildcards; wrapper and helper validate the exact digest.
Defaults:task-list-deploy env_reset
Defaults:task-list-deploy !setenv
Defaults:task-list-deploy secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
task-list-deploy ALL=(root) NOPASSWD: /opt/task-list/release-tool/scripts/deploy.sh
